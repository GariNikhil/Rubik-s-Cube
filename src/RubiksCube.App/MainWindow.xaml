<Window
    x:Class="RubiksCube.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:webview2="using:Microsoft.UI.Xaml.Controls.WebView2"
    Title="Rubik's Cube — Math Thinking">
    <Grid x:Name="RootGrid" Background="{StaticResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="36,30,36,22">
            <TextBlock Text="MATH THINKING FOR SMART" Foreground="{StaticResource AccentBrush}" FontSize="16" FontWeight="SemiBold" CharacterSpacing="180" />
            <TextBlock Text="Rubik's Cube Solving" Foreground="White" FontSize="40" FontWeight="Bold" />
            <TextBlock Text="Explore patterns, permutations, and the logic behind every turn." Foreground="{StaticResource MutedTextBrush}" FontSize="16" Margin="0,8,0,0" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="36,0,36,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="20" Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Pattern map" Foreground="White" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock Text="A visual language for the cube's six color families." Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0" />
                    </StackPanel>
                    <Canvas x:Name="PatternCanvas" Grid.Row="1" Margin="0,24,0,0" />
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="#0B1719" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="20" Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Cube playground" Foreground="White" FontSize="22" FontWeight="SemiBold" />
                            <TextBlock x:Name="StatusText" Text="Solved state" Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="↻" Click="ResetButton_Click" FontSize="22" />
                    </Grid>
                    <Viewbox Grid.Row="1" Margin="20">
                        <webview2:WebView2 x:Name="CubeWebView" Width="320" Height="280" />
                    </Viewbox>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#0B1719" Padding="36,18">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="Scramble" Click="ScrambleButton_Click">
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="R" Modifiers="Control" />
                        </Button.KeyboardAccelerators>
                    </Button>
                    <Button Content="Undo all" Click="UndoAllButton_Click">
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="Z" Modifiers="Control Shift" />
                        </Button.KeyboardAccelerators>
                    </Button>
                    <Button Content="Undo" Click="UndoButton_Click">
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="Z" Modifiers="Control" />
                        </Button.KeyboardAccelerators>
                    </Button>
                    <Button Content="Settings" Click="SettingsButton_Click">
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="Comma" Modifiers="Control" />
                        </Button.KeyboardAccelerators>
                    </Button>
                </StackPanel>
                <TextBlock Grid.Column="1" x:Name="MoveHistoryText" Text="Moves: —" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <ContentDialog x:Name="SettingsDialog"
                       Title="Settings"
                       CloseButtonText="Close"
                       DefaultButton="Close"
                       XamlRoot="{Binding ElementName=RootGrid, Path=XamlRoot}">
            <StackPanel Spacing="12" Width="320">
                <TextBlock Text="Theme" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" />
                <RadioButtons x:Name="ThemeRadioButtons" SelectionChanged="ThemeRadioButtons_SelectionChanged">
                    <RadioButton x:Name="LightThemeRadio" Content="Light" />
                    <RadioButton x:Name="DarkThemeRadio" Content="Dark" />
                </RadioButtons>
            </StackPanel>
        </ContentDialog>
    </Grid>
</Window>