<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>RubiksCube.App</RootNamespace>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <EnableMsixTooling>false</EnableMsixTooling>
    <UseRidGraph>true</UseRidGraph>
    <!-- Code-only UI: no XAML compilation (XamlCompiler.exe incompatible with .NET 10 on this machine) -->
    <DisableXamlCompiler>true</DisableXamlCompiler>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\RubiksCube.Core\RubiksCube.Core.csproj" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.250606001" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3179.45" />
  </ItemGroup>
  <ItemGroup>
    <!-- Exclude XAML files from compilation (code-only UI) -->
    <Page Remove="App.xaml" />
    <Page Remove="MainWindow.xaml" />
    <ApplicationDefinition Remove="App.xaml" />
    <None Include="App.xaml" />
    <None Include="MainWindow.xaml" />
  </ItemGroup>
</Project>
